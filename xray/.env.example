ETHERSCAN_API_KEY=
BSCSCAN_API_KEY=
POLYGONSCAN_API_KEY=
ARBISCAN_API_KEY=
BASESCAN_API_KEY=
OPTIMISTIC_ETHERSCAN_API_KEY=
SNOWTRACE_API_KEY=

DASHSCOPE_API_KEY=
DASHSCOPE_MODEL=qwen3.7-max
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1/chat/completions

# GoPlus security API — optional. Approvals work without credentials (public, rate-limited).
# For higher rate limits, create an App in the GoPlus console and paste the App Key + Secret;
# the server auto-generates and caches a short-lived access token.
GOPLUS_APP_KEY=
GOPLUS_APP_SECRET=
# Alternatively, paste a pre-generated access token directly (overrides the key/secret):
GOPLUS_ACCESS_TOKEN=

ETHEREUM_RPC_URL=
BSC_RPC_URL=
POLYGON_RPC_URL=
ARBITRUM_RPC_URL=
OPTIMISM_RPC_URL=
BASE_RPC_URL=
AVALANCHE_RPC_URL=
SONIC_RPC_URL=
